# Copy this file to .env and replace every value before starting Compose.
DB_NAME=hubstaff_test
DB_USER=hubstaff
DB_PASSWORD=replace-with-a-long-test-password
DB_ROOT_PASSWORD=replace-with-a-different-long-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Wi-Fi IPv4 address of the computer running Docker.
LAN_IP=192.168.1.50

# Set to true only for the first startup of a new test database.
BOOTSTRAP_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_EMPLOYEE_CODE=ADM-001
INITIAL_ADMIN_FIRST_NAME=Test
INITIAL_ADMIN_LAST_NAME=Admin
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_HIRE_DATE=2026-09-24

# The default is enabled. Use a real contact address when it is enabled.
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT=hubstaff-workforce-management/1.0 (contact: admin@example.test)
